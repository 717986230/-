# 运行环境：development | test | production
NODE_ENV=development
PORT=3000
# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://moments:moments@localhost:5432/moments?schema=public

# 生产环境务必替换为至少 32 位的随机字符串
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# 本地存储目录与对外访问前缀
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE=/uploads
# 单文件上传上限（MB）
UPLOAD_MAX_MB=15

# 首次启动时自动创建的管理员（仅当用户不存在时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
