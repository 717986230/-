{
  "name": "moments-template",
  "private": true,
  "description": "朋友圈照片排版模板：移动端 + 服务端 + 运营后台",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm --filter @moments/server start:dev",
    "dev:mobile": "pnpm --filter @moments/mobile dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @moments/server prisma:migrate",
    "db:seed": "pnpm --filter @moments/server prisma:seed"
  }
}
